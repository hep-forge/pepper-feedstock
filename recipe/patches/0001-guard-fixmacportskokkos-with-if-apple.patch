--- a/CMake/EnableKokkos.cmake
+++ b/CMake/EnableKokkos.cmake
@@ -24,10 +24,17 @@ if(Kokkos_FOUND)
       kokkos_check(OPTIONS CUDA_LAMBDA CUDA_CONSTEXPR)
     endif()
 
-    include(CMake/FixMacPortsKokkos.cmake)
