+    # FixMacPortsKokkos.cmake is a macOS/MacPorts/clang-17-specific
+    # workaround (see its own header comment) that pokes at a
+    # Kokkos::LIBDL target -- that target doesn't exist with every
+    # Kokkos build config (e.g. conda-forge's Linux OpenMP/Serial
+    # build), so only run it on Apple platforms as originally intended.
+    if(APPLE)
+      include(CMake/FixMacPortsKokkos.cmake)
+      install(
+        FILES "${PROJECT_SOURCE_DIR}/CMake/FixMacPortsKokkos.cmake"
+        DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/Pepper/Utilities")
+    endif()
 
